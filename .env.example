# Local origin only. Production canonical URLs, sitemap, robots, RSS, and
# Open Graph always use https://www.aiagentsinfo.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional analytics (no keys). If unset, no script is loaded.
# NEXT_PUBLIC_ANALYTICS_DOMAIN=aiagentsinfo.com
# Optional custom script URL (defaults to Plausible's public script).
# NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js

# Optional webmaster verification. A tag is rendered only when the value is
# non-empty. NEXT_PUBLIC_* values are read at build time, so redeploy after
# setting them. Bing Webmaster Tools content for <meta name="msvalidate.01">.
# NEXT_PUBLIC_BING_VERIFICATION=
# Google Search Console content for <meta name="google-site-verification">.
# NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Optional DataFast bot-traffic token (server-side only). Leave unset to send
# crawler events without a bearer token. Never prefix this with NEXT_PUBLIC_.
# DATAFAST_BOT_TOKEN=

# Newsletter (POST /api/newsletter) is a stub. Do not put API keys in the repo.
#
# Tool submissions commit data/submissions/<slug>.json to main on
# sarath59/aiagentsinfo (Contents read/write). Without the token, the form
# falls back to a mailto draft. The public JSON never includes the email.
# Fine-grained PAT: Contents read and write on sarath59/aiagentsinfo.
# Classic PAT: public_repo, or repo if the private issue repo below is set.
# GITHUB_SUBMISSIONS_TOKEN=
# Optional. Public GitHub reads for live trackers (code search for AGENTS.md,
# plus a higher rate limit on repository star counts). Leave unset and the
# tracker pages fall back to the last successful snapshot.
# GITHUB_TOKEN=
# Optional private owner/name. Email is stored only as an issue in this repo.
# Leave unset to drop the email. Do not set this to sarath59/aiagentsinfo.
# If set, the token also needs Issues read and write on that private repo.
# GITHUB_SUBMISSIONS_REPO=

# Report downloads. The form refuses to issue a file until a private store and
# REPORT_DOWNLOAD_SECRET are both set. Do not commit lead rows or these secrets.
#
# Private store, pick one:
# Vercel KV / Upstash Redis REST (supports the admin CSV export and delete):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Or the Upstash names, if the KV_ pair is unset:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Or an HTTPS receiver (Zapier, a private Sheet webhook, Make). This saves
# leads and cannot list or delete them from /api/admin/report-leads.
# LEADS_WEBHOOK_URL=
# LEADS_WEBHOOK_BEARER=
#
# Signs the 30-minute download link. At least 16 characters.
# REPORT_DOWNLOAD_SECRET=
# Bearer token for GET /api/admin/report-leads (CSV) and DELETE ?id= (one row).
# At least 16 characters. Example:
# curl -H "Authorization: Bearer $ADMIN_TOKEN" https://www.aiagentsinfo.com/api/admin/report-leads
# ADMIN_TOKEN=
