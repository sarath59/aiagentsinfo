# Local origin only. Production canonical URLs, sitemap, robots, RSS, and
# Open Graph always use https://www.aiagentsinfo.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional analytics (no keys). If unset, no script is loaded.
# NEXT_PUBLIC_ANALYTICS_DOMAIN=aiagentsinfo.com
# Optional custom script URL (defaults to Plausible's public script).
# NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js

# Newsletter (POST /api/newsletter) is a stub. Do not put API keys in the repo.
#
# Tool submissions commit data/submissions/<slug>.json to main on
# sarath59/aiagentsinfo (Contents read/write). Without the token, the form
# falls back to a mailto draft. The public JSON never includes the email.
# Fine-grained PAT: Contents read and write on sarath59/aiagentsinfo.
# Classic PAT: public_repo, or repo if the private issue repo below is set.
# GITHUB_SUBMISSIONS_TOKEN=
# Optional private owner/name. Email is stored only as an issue in this repo.
# Leave unset to drop the email. Do not set this to sarath59/aiagentsinfo.
# If set, the token also needs Issues read and write on that private repo.
# GITHUB_SUBMISSIONS_REPO=
