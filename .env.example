# Local origin only. Production canonical URLs, sitemap, robots, RSS, and
# Open Graph always use https://www.aiagentsinfo.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional analytics (no keys). If unset, no script is loaded.
# NEXT_PUBLIC_ANALYTICS_DOMAIN=aiagentsinfo.com
# Optional custom script URL (defaults to Plausible's public script).
# NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js

# Newsletter (POST /api/newsletter) is a stub. Do not put API keys in the repo.
#
# Tool submissions (POST /api/submit-tool → GitHub issues labeled tool-submission).
# Required on Vercel or the form falls back to a mailto draft.
# Fine-grained PAT: Issues read and write on the target repository.
# Classic PAT: public_repo (public repo) or repo (private repo).
# GITHUB_SUBMISSIONS_TOKEN=
# Optional owner/name. Defaults to sarath59/aiagentsinfo.
# Use a private repo if submitter emails should not be on public issues.
# GITHUB_SUBMISSIONS_REPO=sarath59/aiagentsinfo
