# Public site origin used for canonical URLs, sitemap, RSS, and Open Graph.
# Set this to https://aiagentsinfo.com in production (Vercel env vars).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional analytics (no keys). If unset, no script is loaded.
# NEXT_PUBLIC_ANALYTICS_DOMAIN=aiagentsinfo.com
# Optional custom script URL (defaults to Plausible's public script).
# NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js

# Newsletter (POST /api/newsletter) and tool submissions (POST /api/submit-tool)
# are stubs. Wire a provider in those route handlers when you are ready.
# Do not put API keys in the repo.
