# Local origin only. Production canonical URLs, sitemap, robots, RSS, and
# Open Graph always use https://www.aiagentsinfo.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional analytics (no keys). If unset, no script is loaded.
# NEXT_PUBLIC_ANALYTICS_DOMAIN=aiagentsinfo.com
# Optional custom script URL (defaults to Plausible's public script).
# NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js

# Optional webmaster verification. A tag is rendered only when the value is
# non-empty. NEXT_PUBLIC_* values are read at build time, so redeploy after
# setting them. Bing Webmaster Tools content for <meta name="msvalidate.01">.
# NEXT_PUBLIC_BING_VERIFICATION=
# Google Search Console content for <meta name="google-site-verification">.
# NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Optional DataFast bot-traffic token (server-side only). Leave unset to send
# crawler events without a bearer token. Never prefix this with NEXT_PUBLIC_.
# DATAFAST_BOT_TOKEN=
# Server-side goals (listing_submitted). If unset, that call is a silent no-op.
# Website API key from DataFast. Never prefix this with NEXT_PUBLIC_.
# DATAFAST_API_KEY=

# This site does not run a newsletter. Do not add an email signup, a Kit form,
# a /newsletter page, or a newsletter_signup DataFast goal. RSS stays.
#
# Tool submissions are saved as rows in the Supabase table directory_submissions.
# Saving a row does not commit to git, so it does not trigger a deploy. Without
# these two values the form falls back to a mailto draft. Server-only: never
# prefix them with NEXT_PUBLIC_. The secret key (sb_secret_...) bypasses row
# level security; the table has RLS on with no policies, so nothing else can
# read it. The project URL may include /rest/v1; only the origin is used.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=
# Required. Signs the submit-form human check. When unset, the server derives
# a key from GITHUB_SUBMISSIONS_TOKEN. When both are unset, submit fails closed
# and offers the email draft. Never prefix this with NEXT_PUBLIC_.
# ALTCHA_HMAC_KEY=
# Optional. Public GitHub reads for live trackers (code search for AGENTS.md,
# plus a higher rate limit on repository star counts). Leave unset and the
# tracker pages fall back to the last successful snapshot.
# GITHUB_TOKEN=
# Legacy. Submissions no longer use it. The tracker reads above fall back to it
# when GITHUB_TOKEN is unset, and the human check derives its key from it when
# ALTCHA_HMAC_KEY is unset.
# GITHUB_SUBMISSIONS_TOKEN=
